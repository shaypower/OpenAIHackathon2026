  "metadata": {
    "scenario_id": "north-tipperary-health-access-demo-v1",
    "scenario_title": "North Tipperary: 45-minute healthcare access screening",
    "active_mode": "intervention",
    "model": {
      "purpose": "Demonstrate an auditable population-to-network-to-service accessibility calculation and compare an indicative feeder intervention under a road-closure stress test.",
      "population": "Every demand count and point is synthetic. Points stand for named localities, not CSO Small Areas or surveyed population centroids.",
      "services": "Healthcare hubs are placeholders near named towns, not verified GP practices or opening hours.",
      "network": "Minutes are hand-entered scenario assumptions. Baseline edges approximate a generalized weekday 09:00 journey and do not come from NTA GTFS, a routable road graph or an observed journey.",
      "intervention": "Proposed feeder links are straight-line map schematics with assumed journey minutes. No route feasibility, fleet, budget, timetable, capacity or return-trip assessment is included.",
      "flood": "Closed links are hypothetical stress-test closures and do not represent OPW mapped flood extents or a forecast.",
      "interpretation": "Use only to exercise the platform. Do not use these outputs to make funding, siting or public-service decisions."
    },
